# ─── Whop ───────────────────────────────────────────────
# Your webhook signing secret (found in the Whop developer dashboard
# next to the webhook you created). Base64-encode it before pasting here.
WHOP_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXXXXXX

# ─── Resend ─────────────────────────────────────────────
# Get a free API key at https://resend.com
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXX

# ─── Notification ───────────────────────────────────────
# Recipients are hardcoded in server.js (ria@ and jean@).
# Edit the NOTIFY_EMAILS array in server.js to change them.

# The "from" address — must be a verified domain on Resend,
# or use the default onboarding address below for testing.
FROM_EMAIL=Whop Alerts <onboarding@resend.dev>

# ─── Server ─────────────────────────────────────────────
PORT=3000
